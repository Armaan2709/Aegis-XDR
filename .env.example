# ==============================================================================
# AegisAI XDR — Enterprise Platform Environment Variables Template
# ==============================================================================

# System Identification & Environment
APP_NAME="AegisAI XDR"
APP_ENV=development
DEBUG=true
API_V1_STR="/api/v1"
SECRET_KEY="CHANGE_THIS_TO_A_SECURE_512_BIT_SECRET_IN_PRODUCTION"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Server Host & Network Boundaries
HOST="0.0.0.0"
PORT=8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000","http://localhost:5173"]

# PostgreSQL Database Configuration
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=aegis_user
POSTGRES_PASSWORD=aegis_secure_password
POSTGRES_DB=aegis_xdr_db
DATABASE_URL=postgresql+asyncpg://aegis_user:aegis_secure_password@postgres:5432/aegis_xdr_db

# Redis Cache & Broker Configuration
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=""
REDIS_URL=redis://redis:6379/0

# Elasticsearch Enterprise Log Engine Configuration
ELASTICSEARCH_HOST=elasticsearch
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://elasticsearch:9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=elastic_secure_password

# AI & LLM Engine Configuration (Ollama / Local / Cloud Models)
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
DEFAULT_LLM_MODEL=llama3:8b
EMBEDDING_MODEL=all-minilm:l6-v2

# Observability & Logging
LOG_LEVEL=INFO
LOG_FORMAT=json
RATE_LIMIT_PER_MINUTE=100
